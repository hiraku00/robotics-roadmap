// 36日目 トランジスタでモーターを回す（MONOist モーター制御(2) のコード）
// 回路：Arduino のピン2 → 625Ω → NPN トランジスタのベース
//       電池（3V）の＋ → DC モーター → トランジスタのコレクタ
//       トランジスタのエミッタ → GND、電池の － も GND（Arduino の GND と共通）
// 動き：1秒回って、1秒止まる（ピン2が HIGH のとき、ベースに電流が流れて、モーターが回る）

void setup() {
  pinMode(2, OUTPUT);          // ピン2を出力にする（トランジスタのベースにつなぐ）
}

void loop() {
  digitalWrite(2, HIGH);       // ピン2を 5V にする → ベース電流が流れる → モーターが回る
  delay(1000);                 // 1秒待つ
  digitalWrite(2, LOW);        // ピン2を 0V にする → ベース電流が止まる → モーターが止まる
  delay(1000);                 // 1秒待つ
}
